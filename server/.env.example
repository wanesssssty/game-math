NODE_ENV=development
# Локально краще 4001: на Windows порт 4000 нерідко займає Docker Desktop (curl дає «Empty reply»).
# Повний стек `docker compose up` у контейнері лишає PORT=4000 через змінні в compose.
PORT=4001
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/game_math?schema=public

# Для JWT (логін / захищені маршрути). У production задай довгий випадковий рядок.
JWT_SECRET=your-super-secret-key-min-32-chars

# Скільки цукерок за одну правильну відповідь у POST /api/problem/answer
CANDY_PER_CORRECT=5
